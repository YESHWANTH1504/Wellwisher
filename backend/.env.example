# WellWisher Backend Environment Configuration (Template)
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wellwisher
DB_USER=root
DB_PASSWORD=your_db_password_here

# JWT Authentication Secret (Must be strong, minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (comma-separated list for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
